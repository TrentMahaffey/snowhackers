# Database Configuration
POSTGRES_DB=snow
POSTGRES_USER=snowuser
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://snowuser:changeme@db:5432/snow

# Django Configuration
DJANGO_SECRET_KEY=changeme-generate-a-secret-key

# Timezone and Region
TIMEZONE=America/Denver

# Weather Models
MODELS=gfs,icon,ecmwf
SNOTEL_STATES=CO,UT,WY,ID,MT,WA,OR,CA,NV,NM,AZ

# Forecast Settings
FORECAST_DAYS_AHEAD=14
OBS_DAYS_BACK=14

# AWDB API Settings
AWDB_RETRIES=4
AWDB_BACKOFF=0.8
AWDB_CHUNK_SIZE=20
VERBOSE=1

# Django Allowed Hosts (comma-separated). For Cloudflare-tunneled deploys, include
# your public hostname(s) here.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DEBUG=False

# Snow Cam Integration (optional). Set to absolute paths on your host if you have
# snow cam timelapse videos. Otherwise the docker volumes mount empty default dirs
# and the Snow Cams page renders empty.
SNOWCAM_TIMELAPSE_DIR=./snowcam/timelapses
SNOWCAM_TIMELAPSE7_DIR=./snowcam/timelapses7
SNOWCAM_TIMELAPSE30_DIR=./snowcam/timelapses30
SNOWCAM_OUT_DIR=./snowcam/out
