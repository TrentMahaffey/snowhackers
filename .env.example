# Database Configuration
POSTGRES_DB=snow
POSTGRES_USER=snowuser
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://snowuser:changeme@db:5432/snow

# Django Configuration
DJANGO_SECRET_KEY=changeme-generate-a-secret-key

# Timezone and Region
TIMEZONE=America/Denver

# Weather Models
MODELS=gfs,icon,ecmwf
SNOTEL_STATES=CO,UT,WY,ID,MT,WA,OR,CA,NV,NM,AZ

# Forecast Settings
FORECAST_DAYS_AHEAD=14
OBS_DAYS_BACK=14

# AWDB API Settings
AWDB_RETRIES=4
AWDB_BACKOFF=0.8
AWDB_CHUNK_SIZE=20
VERBOSE=1
